package ud3;

import java.util.Scanner;

public class primode5 {

	public static void main(String[] args) {
		//Habilitamos la lectura de datos por consola
		Scanner num=new Scanner(System.in);
		
		System.out.println("Introduce un número del 1 al 5 para saber si es primo");
		//Leemos un entero
		int entrada=num.nextInt();
		
		if (entrada > 5 || entrada <= 0) {
			System.out.println("Error, ese número no está entre 1 y 5");
		}
		else if (entrada == 4) {
			System.out.println("El número no es primo");
		}
		else if (entrada != 4) {
			System.out.println("El número es primo");
		}
	}

}
